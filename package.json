{
  "name": "dsh-memory-refine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "记忆提炼：把长对话整理成你点头之后才写入的长期记忆条目。自动读会话事件流取料，剥掉注入提示词、运行时快照与推理正文；提炼出候选后必须逐条确认才落盘；写入走版本预检、整份备份、读回核验三道闸。侧边栏面板可查看、编辑、导入、删除记忆文件。",
  "icon": "./icon.png",
  "license": "MIT",
  "author": "mjtwt",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-refine",
    "long-term-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
